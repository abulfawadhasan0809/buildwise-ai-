# Gnani AI (keep server-side only)
GNANI_API_KEY=your_api_key
# Set these to the endpoints from your Gnani developer dashboard
GNANI_STT_URL=https://api.gnani.ai/prisma/transcribe
GNANI_TTS_URL=https://api.gnani.ai/timbre/synthesize
GNANI_LANG=en-IN
# Optional: enables LLM-written explanations. Without it, built-in rule engine is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ALLOWED_ORIGIN=http://localhost:3000
